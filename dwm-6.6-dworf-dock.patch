+void
+updatedocks(Monitor *m)
+{
+	Client *c;
+
+	for (c = m->clients; c; c = c->next) {
+		if (!c->isdock)
+			continue;
+
+		if (c->w / c->h >= 1) {
+			if (c->y < m->my + m->mh / 2) {
+				resize(c, m->wx, m->wy, m->ww, c->h, 1);
+				m->wy += c->h;
+				m->wh -= c->h;
+			} else {
+				resize(c, m->wx, m->wy + m->wh - c->h, m->ww, c->h, 1);
+				m->wh -= c->h;
+			}
+		} else {
+			if (c->x < m->mx + m->mw / 2) {
+				resize(c, m->wx, m->wy, c->w, m->wh, 1);
+				m->wx += c->w;
+				m->ww -= c->w;
+			} else {
+				resize(c, m->wx + m->ww - c->w, m->wy, c->w, m->wh, 1);
+				m->ww -= c->w;
+			}
+		}
+	}
